RuntimeDownloads/*
!RuntimeDownloads/.gitkeep
!RuntimeDownloads/download_runtime.py
ModelDownloads/*
!ModelDownloads/.gitkeep

# Model weights/tokenizers fetched by each Examples/*/Models/<Name>/download_model.py;
# model.json (hand-authored metadata) and the download script itself stay tracked.
Examples/*/Models/*/*
!Examples/*/Models/*/model.json
!Examples/*/Models/*/download_model.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Runtime side effects (e.g. an OAAX runtime's own logs/model cache, written
# to the working directory when a test's --config doesn't redirect them)
runtime.log
*.log
*.blob

# Annotated images an Examples/ script writes next to its input
*.detections.jpg
