{
  "name": "Face-Detection",
  "inputs": [
    {
      "name": "image-",
      "element_type": "FLOAT",
      "shape": [1, 3, 240, 320],
      "mean": [127, 127, 127],
      "normalization": [128, 128, 128]
    },
    {
      "name": "nms_sensitivity-",
      "element_type": "FLOAT",
      "shape": [1],
      "value": 0.5
    }
  ],
  "outputs": [
    {
      "name": "bboxes-format:xyxysc;0:Face",
      "element_type": "FLOAT",
      "shape": [20, 6]
    }
  ]
}
