{
  "name": "Face-Detection",
  "inputs": [
    {
      "name": "input",
      "element_type": "FLOAT",
      "shape": [1, 3, 240, 320],
      "mean": [127, 127, 127],
      "normalization": [128, 128, 128]
    }
  ],
  "outputs": [
    {
      "name": "scores",
      "element_type": "FLOAT",
      "shape": [1, 4420, 2],
      "role": "scores",
      "labels": ["BACKGROUND", "face"]
    },
    {
      "name": "boxes",
      "element_type": "FLOAT",
      "shape": [1, 4420, 4],
      "role": "boxes"
    }
  ]
}
